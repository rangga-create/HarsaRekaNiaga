"use client";

import {
  createContext,
  useContext,
  useState,
  useEffect,
  useCallback,
} from "react";
import {
  Supplier,
  Buyer,
  BuyerInteraction,
  FollowUp,
  Deal,
  CalculatorScenario,
  Commission,
  CommissionDistribution,
  ActivityLog,
  UserProfile,
  Product,
} from "@/lib/data";
import {
  loadStoredData,
  saveData,
  resetStoredData,
  StoredData,
} from "@/lib/storage";

interface DemoStoreValue {
  data: StoredData;
  refresh: () => StoredData;
  reset: () => StoredData;
  markDemo: (record: { demo: boolean }) => void;
}

const DemoStore = createContext<DemoStoreValue | null>(null);

export function DemoStoreProvider({
  children,
}: {
  children: React.ReactNode;
}) {
  const [data, setData] = useState<StoredData>(() => loadStoredData());

  const refresh = useCallback((): StoredData => {
    const next = loadStoredData();
    setData(next);
    return next;
  }, []);

  const reset = useCallback((): StoredData => {
    const next = resetStoredData();
    setData(next);
    return next;
  }, []);

  useEffect(() => {
    saveData(data);
  }, [data]);

  return (
    <DemoStore.Provider
      value={{
        data,
        refresh,
        reset,
        markDemo: (record) => {
          record.demo = true;
        },
      }}
    >
      {children}
    </DemoStore.Provider>
  );
}

export function useDemoStore() {
  const ctx = useContext(DemoStore);
  if (!ctx) {
    throw new Error("useDemoStore must be used within DemoStoreProvider");
  }
  return ctx;
}

type DataUpdater<T> = (current: StoredData) => StoredData;

function withData<T>(
  setData: React.Dispatch<React.SetStateAction<StoredData>>,
  mutator: (current: StoredData) => StoredData
) {
  setData(mutator);
}

export function useSuppliers() {
  const { data, refresh } = useDemoStore();
  const setData = useDemoStore().data;
  const [, forceUpdate] = useState(0);
  const wrappedSetData = useCallback(
    (mutator: (current: StoredData) => StoredData) => {
      const current = useDemoStore().data;
      const next = mutator(current);
      saveData(next);
      // force re-render by updating transient counter
      forceUpdate((n) => n + 1);
    },
    [forceUpdate]
  );

  return {
    list: data.suppliers,
    add: (s: Supplier) => {
      saveData({ ...data, suppliers: [...data.suppliers, s] });
      forceUpdate((n) => n + 1);
    },
    update: (id: string, changes: Partial<Supplier>) => {
      saveData({
        ...data,
        suppliers: data.suppliers.map((s) =>
          s.id === id ? { ...s, ...changes } : s
        ),
      });
      forceUpdate((n) => n + 1);
    },
    remove: (id: string) => {
      saveData({
        ...data,
        suppliers: data.suppliers.filter((s) => s.id !== id),
      });
      forceUpdate((n) => n + 1);
    },
    refresh,
  };
}

