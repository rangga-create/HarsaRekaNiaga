export function useCommissionDistribution() {
  const { data, refresh } = useDemoStore();
  const [, forceUpdate] = useState(0);
  return {
    value: data.commissionDistribution,
    update: (changes: Partial<CommissionDistribution>) => {
      saveData({
        ...data,
        commissionDistribution: {
          ...data.commissionDistribution,
          ...changes,
          updatedAt: new Date().toISOString(),
        },
      });
      forceUpdate((n) => n + 1);
    },
    refresh,
  };
}

